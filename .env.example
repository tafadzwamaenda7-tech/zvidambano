# Supabase Configuration
# Get these values from your Supabase project at https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (server-only, never expose to client)
SUPABASE_SERVICE_KEY=your-service-key-here

# App Configuration
VITE_APP_NAME=ZVIDA
VITE_APP_ENV=development

# Web Push (VAPID)
# Generate a keypair with: npx web-push generate-vapid-keys --json
# Public key goes here (client-side). Private key + subject go in the
# Supabase Edge Function secrets as VAPID_PRIVATE_KEY / VAPID_SUBJECT.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
